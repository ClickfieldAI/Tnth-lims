# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local
!.env.example

# local sqlite development database + generated schema variant
prisma/dev.db
prisma/dev.db-journal
prisma/schema.local.prisma

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local logs
*.log
.env*

# migration scratch artifacts
.sql/
.schema-data.json
.schema-infer.json
.columns.json
.rel-dump.json
.fks.json
.missing-cols.json
