generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model permission {
  id String @id @default(cuid())
  code String?
  name String?
  module String?
  createdAt DateTime? @default(now())
  roles permissionRole[] @relation("permissionRole_permissionId")
}

model role {
  id String @id @default(cuid())
  name String?
  description String?
  isSystem Boolean?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  permissions permissionRole[] @relation("permissionRole_roleId")
  users user[] @relation("user_roleId")
}

model permissionRole {
  roleId String?
  permissionId String?
  id String @id @default(cuid())
  createdAt DateTime? @default(now())
  role role? @relation("permissionRole_roleId", fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission permission? @relation("permissionRole_permissionId", fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

