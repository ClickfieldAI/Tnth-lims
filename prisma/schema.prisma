// ============================================================
// PHARMA-LIMS — Relational Database Schema
// Canonical provider: PostgreSQL. SQLite dev variant generated by
// prisma/scripts/gen-sqlite.mjs.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ACCESS CONTROL ----------------
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  users       User[]
  permissions PermissionRole[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  module    String
  roles     PermissionRole[]
  createdAt DateTime @default(now())
}

model PermissionRole {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  title        String?
  signature    String?
  isActive     Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  samples      Sample[] @relation("sampleCreatedBy")
  assignedSamples Sample[] @relation("sampleAssignedTo")
  auditLogs    AuditLog[]
  approvals    Approval[]
  documentApprovals Document[] @relation("docApprovedBy")
  ownedDocuments Document[] @relation("docOwner")
  assignedTests  Test[] @relation("testAssignedTo")
  messages       Message[]
  deviations     Deviation[]
  capas          Capa[]
  changeControls ChangeControl[]
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
  @@index([clientId])
}
// ---------------- CLIENTS / COMPANIES ----------------
model Client {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  industry      String?
  address       String?
  city          String?
  country       String?
  contactPerson String?
  email         String?
  phone         String?
  isActive      Boolean @default(true)
  users         User[]
  samples       Sample[]
  products      Product[]
  invoices      Invoice[]
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique
  amount    Float
  currency  String   @default("USD")
  status    String   @default("UNPAID")
  issuedAt  DateTime
  dueAt     DateTime?
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  samples   Sample[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------- PRODUCTS & BATCHES ----------------
model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  dosage          String?
  form            String?
  monograph       String?
  activeIngredient String?
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  batches         Batch[]
  samples         Sample[]
  stabilityStudies StabilityStudy[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Batch {
  id               String   @id @default(cuid())
  batchNumber      String   @unique
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  mfgDate          DateTime?
  expDate          DateTime?
  quantity         Float?
  releaseStatus    String   @default("TESTING")
  samples          Sample[]
  stabilityStudies StabilityStudy[]
  coaReports       TestReport[]
  releasedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
}
// ---------------- SAMPLES ----------------
model Sample {
  id               String   @id @default(cuid())
  sampleCode       String   @unique
  barcode          String   @unique
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id])
  productId        String?
  product          Product? @relation(fields: [productId], references: [id])
  batchId          String?
  batch            Batch?   @relation(fields: [batchId], references: [id])
  productName      String?
  batchNumber      String?
  mfgDate          DateTime?
  expDate          DateTime?
  quantity         Float?
  unit             String?
  storageCondition String?
  storageLocation  String?
  receivedDate     DateTime
  priority         String   @default("NORMAL")
  status           String   @default("RECEIVED")
  coOwner        String?
  requestedTests Json
  assignedToId     String?
  assignedTo       User?    @relation("sampleAssignedTo", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?    @relation("sampleCreatedBy", fields: [createdById], references: [id])
  notes            String?
  tests            Test[]
  custodyRecords   ChainOfCustody[]
  storageEvents    StorageEvent[]
  attachedDocuments Document[]
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  testReports      TestReport[]
  deviations       Deviation[]
  messages         Message[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([priority])
}

model ChainOfCustody {
  id           String   @id @default(cuid())
  sampleId     String
  sample       Sample   @relation(fields: [sampleId], references: [id])
  fromUserId   String?
  toUserId     String?
  action       String
  locationNote String?
  at           DateTime @default(now())
  note         String?

  @@index([sampleId])
}

model StorageEvent {
  id            String @id @default(cuid())
  sampleId      String
  sample        Sample @relation(fields: [sampleId], references: [id])
  location      String
  condition     String?
  action        String
  performedById String?
  at            DateTime @default(now())
  note          String?
  @@index([sampleId])
}
// ---------------- TESTS & RESULTS ----------------
model Test {
  id            String  @id @default(cuid())
  requestCode   String  @unique
  sampleId      String
  sample        Sample  @relation(fields: [sampleId], references: [id])
  type          String
  testName      String
  method        String?
  status        String  @default("PENDING")
  priority      String?
  assignedToId  String?
  assignedTo    User?   @relation("testAssignedTo", fields: [assignedToId], references: [id])
  instrumentId  String?
  instrument    Instrument? @relation(fields: [instrumentId], references: [id])
  startedAt     DateTime?
  completedAt   DateTime?
  dueDate       DateTime?
  result        String?
  resultStatus  String?
  worksheetData Json?
  attachments   Json?
  reviewedById  String?
  reviewedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  assayResult   AssayResult?
  dissolution   DissolutionResult?
  impurityResult ImpurityResult?
  microbiology  MicrobiologyResult?
  report        TestReport?
  stabilityTimepoints StabilityTimepoint[]
  deviations    Deviation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sampleId])
  @@index([type])
  @@index([status])
}

model AssayResult {
  id                String   @id @default(cuid())
  testId            String   @unique
  test              Test     @relation(fields: [testId], references: [id])
  apiLabel          String?
  expectedLow       Float?
  expectedHigh      Float?
  resultPercent     Float?
  calculationMethod String?
  observations      String?
  specPass          Boolean?
  instrumentId      String?
  chromatogram      String?
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DissolutionResult {
  id           String    @id @default(cuid())
  testId       String   @unique
  test         Test      @relation(fields: [testId], references: [id])
  apparatus    String?
  medium       String?
  rpm          Int?
  temperature  Float?
  timepoints   Json?
  observations String?
  pass         Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ImpurityResult {
  id              String   @id @default(cuid())
  testId          String   @unique
  test            Test     @relation(fields: [testId], references: [id])
  impurityName    String
  type            String   @default("RELATED_SUBSTANCE")
  specLimit       String?
  specMax         Float?
  observedValue   Float?
  analyticalMethod String?
  instrumentId    String?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MicrobiologyResult {
  id             String    @id @default(cuid())
  testId         String   @unique
  test           Test      @relation(fields: [testId], references: [id])
  testType       String    @default("TOTAL_BACTERIAL")
  media          String?
  incubationTemp Float?
  incubationTime Float?
  colonyCount    Float?
  limitSpec      String?
  pass           Boolean?
  observations   String?
  instrumentId   String?
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
// ---------------- STABILITY ----------------
model StabilityStudy {
  id              String   @id @default(cuid())
  studyId         String   @unique
  protocol         String   @default("LONG_TERM")
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch    @relation(fields: [batchId], references: [id])
  storageCondition String
  intervals        Json
  startDate        DateTime
  endDate          DateTime?
  status           String   @default("ACTIVE")
  timepoints       StabilityTimepoint[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StabilityTimepoint {
  id          String   @id @default(cuid())
  studyId     String
  study       StabilityStudy @relation(fields: [studyId], references: [id])
  interval    String
  dueDate     DateTime
  status      String   @default("SCHEDULED")
  testId      String?
  test        Test?    @relation(fields: [testId], references: [id])
  completedAt DateTime?
  result      String?
  createdAt   DateTime @default(now())
  @@index([studyId])
}

// ---------------- INSTRUMENTS ----------------
model Instrument {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  category            String   @default("HPLC")
  manufacturer        String?
  model               String?
  serialNumber        String?
  location            String?
  status              String   @default("AVAILABLE")
  calibrationFrequency Int?
  lastCalibrated      DateTime?
  nextCalibration     DateTime?
  calibrationStatus   String   @default("VALID")
  columnInfo          String?
  notes               String?
  calibrations        CalibrationRecord[]
  tests               Test[]
  maintenanceLogs     MaintenanceLog[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CalibrationRecord {
  id           String   @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  performedAt  DateTime
  dueAt        DateTime?
  byUserId     String?
  certificate  String?
  result       String?
  notes        String?
  createdAt    DateTime @default(now())
}

model MaintenanceLog {
  id            String   @id @default(cuid())
  instrumentId  String
  instrument    Instrument @relation(fields: [instrumentId], references: [id])
  performedAt   DateTime
  type          String   @default("PREVENTIVE")
  description   String?
  performedById String?
  cost          Float?
  serviceCompany String?
  createdAt     DateTime @default(now())
}
// ---------------- QUALITY: DEVIATIONS / CAPA / CHANGE CONTROL ----------------
model Deviation {
  id                String   @id @default(cuid())
  deviationId       String   @unique
  sampleId          String?
  sample            Sample?  @relation(fields: [sampleId], references: [id])
  testId            String?
  test              Test?    @relation(fields: [testId], references: [id])
  description       String
  category          String   @default("ANALYTICAL")
  impactLevel       String?
  rootCause         String?
  correctiveAction  String?
  status            String   @default("OPEN")
  reportedById      String?
  reportedBy        User?    @relation(fields: [reportedById], references: [id])
  approvedById      String?
  closedAt          DateTime?
  capas             Capa[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Capa {
  id                String    @id @default(cuid())
  capaId            String    @unique
  title             String
  type              String    @default("CORRECTIVE")
  description       String?
  rootCause         String?
  action            String?
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id])
  dueDate           DateTime?
  status            String    @default("OPEN")
  relatedDeviationId String?
  relatedDeviation  Deviation? @relation(fields: [relatedDeviationId], references: [id])
  effectiveness     String?
  closedById        String?
  closedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ChangeControl {
  id             String   @id @default(cuid())
  ccId           String   @unique
  title          String
  description    String?
  category       String   @default("METHOD")
  impactAnalysis Json?
  justification  String?
  proposedBy     String?
  status         String   @default("DRAFT")
  approvedById   String?
  approvedBy     User?    @relation(fields: [approvedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
// ---------------- DOCUMENTS ----------------
model Document {
  id           String    @id @default(cuid())
  docCode      String    @unique
  title        String
  category     String    @default("SOP")
  version      String    @default("1.0")
  status       String    @default("DRAFT")
  filePath     String?
  mimeType     String?
  fileSize     Int?
  signedBy     String?
  approvedByUserId String?
  approvedBy   User?     @relation("docApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt   DateTime?
  ownerId      String?
  owner        User?     @relation("docOwner", fields: [ownerId], references: [id])
  previousVersionId String?
  sampleId     String?
  sample       Sample?   @relation(fields: [sampleId], references: [id])
  reportId     String?
  report       TestReport? @relation(fields: [reportId], references: [id])
  approverLogic Json?
  digitalSignature String?
  downloadHistory DownloadRecord[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model DownloadRecord {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  userId      String?
  downloadedAt DateTime @default(now())
  ip          String?
}

// ---------------- REPORTS ----------------
model TestReport {
  id           String    @id @default(cuid())
  reportCode   String    @unique
  sampleId     String?
  sample       Sample?   @relation(fields: [sampleId], references: [id])
  batchId      String?
  batch        Batch?    @relation(fields: [batchId], references: [id])
  testId       String?  @unique
  test         Test?     @relation(fields: [testId], references: [id])
  type         String    @default("TEST")
  title        String
  content      Json?
  pdfPath      String?
  status       String    @default("DRAFT")
  generatedById String?
  approvedById String?
  approvedAt   DateTime?
  digitalSignature String?
  documents    Document[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
// ---------------- APPROVALS / AUDIT / MESSAGES ----------------
model Approval {
  id            String   @id @default(cuid())
  referenceType String
  referenceId   String
  approverId    String
  approver      User     @relation(fields: [approverId], references: [id])
  action        String   @default("APPROVE")
  comment       String?
  at            DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([referenceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  module     String
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityId])
  @@index([module])
}

model Message {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  sampleId   String?
  sample     Sample?  @relation(fields: [sampleId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id])
  body       String
  fromClient Boolean  @default(false)
  createdAt  DateTime @default(now())
}