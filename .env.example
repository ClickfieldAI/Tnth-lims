# ============================================================
# PharmaLIMS — Environment Variables
# Copy to .env for local development, or configure in
# Vercel → Settings → Environment Variables.
# NEVER commit real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# DATA PERSISTENCE (optional)
#
# This app runs on an in-memory mock data store (lib/mock/engine.ts) rather
# than a real database — no DATABASE_URL needed. That's fine for local dev
# (`npm run dev` keeps one process alive the whole time), but Vercel runs
# the app as serverless functions: each invocation can land on an isolated
# instance with no shared memory, so without persistence, data created in
# one request can appear to vanish on the next.
#
# To make data survive across Vercel invocations, add these two (they match
# what Vercel's "Upstash for Redis" Storage integration auto-injects, so
# adding that integration from the project's Storage tab needs no further
# config). Leave both unset for local dev — persistence is then a no-op and
# nothing about local behavior changes.
# ------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ------------------------------------------------------------
# AUTHENTICATION (required)
#
# Secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32        (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Must be changed from the default before deploying.
# ------------------------------------------------------------
AUTH_SECRET="generate-a-strong-random-secret-here"

# Session lifetime in days (optional, default 7).
SESSION_TTL_DAYS=7

# ------------------------------------------------------------
# APPLICATION (optional)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PharmaLIMS"