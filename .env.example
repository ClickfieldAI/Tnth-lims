# ============================================================
# PharmaLIMS — Environment Variables
# Copy to .env for local development, or configure in
# Vercel → Settings → Environment Variables.
# NEVER commit real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# DATABASE (required)
#
# Production (Vercel) — PostgreSQL / Supabase:
#   Supabase: Dashboard → Project Settings → Database → Connection string.
#   Use the CONNECTION POOLER URL (port 6543) for serverless runtimes:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   Use the direct connection (port 5432) as DIRECT_URL for migrations:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.supabase.com:5432/postgres
#
# Local development alternative: `npm run db:local` uses SQLite and does not
# require this variable at runtime (see prisma/scripts/gen-sqlite.mjs).
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/pharma_lims"

# Optional — direct (non-pooled) connection used by Prisma Migrate only.
# Recommended when running migrations against Supabase/Neon/PGPool setups.
DIRECT_URL="postgresql://user:password@host:5432/pharma_lims"

# ------------------------------------------------------------
# AUTHENTICATION (required)
#
# Secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32        (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Must be changed from the default before deploying.
# ------------------------------------------------------------
AUTH_SECRET="generate-a-strong-random-secret-here"

# Session lifetime in days (optional, default 7).
SESSION_TTL_DAYS=7

# ------------------------------------------------------------
# APPLICATION (optional)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="PharmaLIMS"